	async function unzip7z(zipBlob, targetFile) {
	
    const zip = await JSZip.loadAsync(zipBlob);
	
    const file = zip.file(targetFile);
    if (!file) throw new Error(`File not found: ${targetFile}`);

    const blob = await file.async("blob");
	const finalBlob = blob.slice(0, blob.size, "application/wasm")
            
	
    return URL.createObjectURL(finalBlob);
}

