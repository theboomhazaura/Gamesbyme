const module = await JS7z({
    locateFile: () => {
        console.log("locateFile");
        return blob7z;
    },

    onRuntimeInitialized() {
        console.log("WASM runtime initialized");
    }
});
}

async function extract7zURL(dataURL) {
    const data = dataURL

const archive = !dataURL.startsWith("data:")
    ? base91Decode(data)
    : Uint8Array.from(atob(data), c => c.charCodeAt(0));

    const js7z = await JS7z({
        print: x => console.log("STDOUT:", x),
        printErr: x => console.error("STDERR:", x)
    });

    
    js7z.FS.writeFile("/archive.7z", archive);

    
    js7z.FS.mkdir("/out");

    const code = js7z.callMain([
        "x",
        "/archive.7z",
        "-o/out",
        "-y"
    ]);

    

    const blobs = {};

    function walk(dir) {
    for (const name of js7z.FS.readdir(dir)) {
        if (name === "." || name === "..") continue;
        const path = dir + "/" + name;
        const stat = js7z.FS.stat(path);
        if (js7z.FS.isDir(stat.mode)) {
            walk(path);
        } else {
            const data = js7z.FS.readFile(path);
            const relativePath = path.slice("/out/".length); 
            blobs[relativePath] = URL.createObjectURL(new Blob([data]));
        }
    }
}

    walk("/out");

    return blobs;
}


const BASE91_TABLE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&()*+,./:;<=>?@[]^_`{|}~"';
const BASE91_DECODE = {};

for (let i = 0; i < 91; i++) {
    BASE91_DECODE[BASE91_TABLE[i]] = i;
}

function base91Decode(str) {
    let v = -1, b = 0, n = 0;
    const out = [];

    for (let i = 0; i < str.length; i++) {
        const c = BASE91_DECODE[str[i]];
        if (c === undefined) continue;

        if (v < 0) {
            v = c;
        } else {
            v += c * 91;
            n |= v << b;
            b += (v & 8191) > 88 ? 13 : 14;

            while (b >= 8) {
                out.push(n & 255);
                n >>= 8;
                b -= 8;
            }

            v = -1;
        }
    }

    if (v >= 0) out.push((n | (v << b)) & 255);

    return new Uint8Array(out);
}
 
function dataUriToBlob(dataUri) {
    const [meta, data] = dataUri.split(",");
    const mime = meta.match(/data:(.*?);base64/)[1];
    const bin = atob(data);

    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) {
        bytes[i] = bin.charCodeAt(i);
    }

    return new Blob([bytes], { type: mime });
}


 
async function unzipToBlobUrls(zipBlob) {
    const zip = await JSZip.loadAsync(zipBlob);
    const blobUrls = {};

    for (const [filename, file] of Object.entries(zip.files)) {
        if (file.dir) continue;

        const lower = filename.toLowerCase();
        let mime = "";

        if (lower.endsWith(".js") || lower.endsWith(".mjs")) mime = "text/javascript";
        else if (lower.endsWith(".css")) mime = "text/css";
        else if (lower.endsWith(".html") || lower.endsWith(".htm")) mime = "text/html";
        else if (lower.endsWith(".webp")) mime = "image/webp";
        else if (lower.endsWith(".png")) mime = "image/png";
        else if (lower.endsWith(".jpg") || lower.endsWith(".jpeg")) mime = "image/jpeg";
        else if (lower.endsWith(".svg")) mime = "image/svg+xml";
        else if (lower.endsWith(".json")) mime = "application/json";
        else if (lower.endsWith(".wasm")) mime = "application/wasm";

        const rawBlob = await file.async("blob");
        const finalBlob = mime
            ? rawBlob.slice(0, rawBlob.size, mime)
            : rawBlob;

        blobUrls[filename] = URL.createObjectURL(finalBlob);
		console.log(filename);
    }

    return blobUrls;
}



async function loadZip(input, DATA_COMPRESSED) {
    let zipBlob;

    if (DATA_COMPRESSED) {
        
        zipBlob = base91DecodeToBlob(input);
    } else {
   
        zipBlob = dataUriToBlob(input);
    }

    return unzipToBlobUrls(zipBlob);
}




